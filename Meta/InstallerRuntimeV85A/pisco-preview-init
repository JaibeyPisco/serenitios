import json
import os
from pathlib import Path
import subprocess
import threading
import time
import pisco_preview_policy as policy


def run():
    config = json.loads(Path('/etc/pisco-preview.json').read_text())
    policy.protect()
    devices = []
    for attempt in range(30):
        policy.protect()
        probe = subprocess.run(['blkid', '-c', '/dev/null', '-t', 'UUID='+config['data_uuid'], '-o', 'device'],
                               text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if probe.returncode not in [0, 2]:
            raise RuntimeError('medium identification failed')
        devices = probe.stdout.split()
        if devices:
            break
        time.sleep(1)
    if len(devices) != 1:
        raise RuntimeError('installer medium missing or ambiguous')
    partition = Path('/sys/class/block') / Path(devices[0]).name
    if not (partition / 'partition').exists():
        raise RuntimeError('expected data partition')
    source = '/dev/' + partition.resolve().parent.name
    Path('/run/pisco/source').write_text(source+'\n')
    policy.save_state(source)
    subprocess.run(['mount', '-t', 'ext4', '-o', 'ro,noload', devices[0], '/media/pisco'], check=True)
    if Path('/media/pisco/PISCO_PREVIEW_ID').read_text().strip() != 'PISCO-V85A':
        raise RuntimeError('wrong preview medium')
    def guard():
        while True:
            try:
                policy.protect()
            except Exception:
                print('V85A SAFETY FAILURE', flush=True)
            time.sleep(.5)
    threading.Thread(target=guard, daemon=True).start()
    print('V85A READY preview-only, block protection active', flush=True)
    while True:
        subprocess.run(['/bin/python3', '/bin/pisco-start-gui'])
        time.sleep(5)


try:
    run()
except Exception as error:
    print('V85A SAFETY STOP: '+type(error).__name__+': '+str(error)+'; no GUI or installation.', flush=True)
    while True:
        time.sleep(60)
